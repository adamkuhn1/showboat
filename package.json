{
  "name": "@portfolio-suite/showboat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "vite build && node scripts/verify-build-model.mjs",
    "preview": "vite preview --port 5175 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/wasm-provenance.mjs && vitest run",
    "test:wasm": "cargo test --manifest-path physics-core/Cargo.toml",
    "build:wasm": "wasm-pack build physics-core --target web --out-dir ../src/wasm --out-name showboat_physics && rm -f src/wasm/.gitignore src/wasm/package.json",
    "ranker:gen-dataset": "tsx training/ranker/gen_dataset.ts",
    "ranker:gen-smoke": "RANKER_PROFILE=smoke tsx training/ranker/phase2c/gen_dataset_v3.ts",
    "ranker:gen-pilot": "RANKER_PROFILE=pilot tsx training/ranker/phase2c/gen_dataset_v3.ts",
    "ranker:gen-baseline": "RANKER_PROFILE=baseline tsx training/ranker/phase2c/gen_dataset_v3.ts",
    "ranker:gen-full": "RANKER_PROFILE=full tsx training/ranker/phase2c/gen_dataset_v3.ts",
    "ranker:gen-parallel": "tsx training/ranker/phase2c/parallel.ts",
    "ranker:validate": "tsx training/ranker/phase2c/validate.ts",
    "ranker:report": "tsx training/ranker/phase2c/report.ts",
    "ranker:split-check": "tsx training/ranker/phase2c/split_check.ts",
    "ranker:perturbation-benchmark": "tsx training/ranker/phase2c/perturbation_benchmark.ts",
    "ranker:throughput-profile": "tsx training/ranker/phase2c/throughput_profile.ts",
    "ranker:clean-tmp": "find training/ranker/phase2c/data -name '*.tmp' -delete",
    "model:stage": "node scripts/stage-production-model-phase2e.mjs",
    "model:stage:phase2d": "node scripts/stage-production-model.mjs",
    "model:verify": "node scripts/verify-build-model.mjs",
    "eval:hybrid": "tsx eval/hybridEval.ts",
    "eval:gate": "tsx eval/gateReport.ts",
    "eval:trickonly": "tsx eval/trickOnlyEval.ts",
    "eval:trickonly-gate": "tsx eval/trickOnlyGateReport.ts",
    "qa:motion": "tsx qa/time-mapping.ts",
    "wasm:provenance": "node scripts/wasm-provenance.mjs",
    "wasm:provenance:update": "node scripts/wasm-provenance.mjs --update"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
